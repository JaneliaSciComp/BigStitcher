  <artifactId>BigStitcher</artifactId>
  <name>Big Stitcher</name>
  <version>3.0.9-SNAPSHOT</version>
  <description>Multiview stitching of large datasets.</description>
  <url>https://github.com/JaneliaSciComp/BigStitcher</url>
  <issueManagement>
