  <contributors>
    <contributor>
      <name>Tobias Pietzsch</name>
      <url>https://imagej.net/people/tpietzsch</url>
      <properties>
        <id>tpietzsch</id>
      </properties>
    </contributor>
    <contributor>
      <name>Curtis Rueden</name>
      <url>https://imagej.net/people/ctrueden</url>
